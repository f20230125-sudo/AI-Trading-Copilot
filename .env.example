# Optional. Without this set, the agent runs in offline template mode
# (same tool pipeline, deterministic text instead of an LLM-composed answer).
ANTHROPIC_API_KEY=

# Optional, defaults to claude-sonnet-5.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional. Set to "synthetic" to force the offline deterministic data
# generator instead of live Yahoo Finance data (used automatically in tests/CI).
AI_TRADING_COPILOT_DATA_SOURCE=
